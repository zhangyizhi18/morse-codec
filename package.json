{
  "name": "morse-codec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "摩斯电码调制解调 - 输入文字生成音频，导入音频翻译出文字",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsx scripts/verify.ts",
    "build:codes": "tsx scripts/build-codes.ts",
    "typecheck": "tsc --noEmit",
    "electron": "npm run build:fast && electron .",
    "electron:dir": "npm run build:fast && electron-builder --win --dir",
    "electron:dist": "npm run build:fast && electron-builder --win",
    "cap:sync": "npm run build:fast && cap sync android",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "build": {
    "appId": "com.morse.codec",
    "productName": "MorseCodec",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "摩斯电码"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "chinese-telegraph-code": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
